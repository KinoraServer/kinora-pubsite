const links = (config.social ?? []).filter(({ icon }) => icon in ICONS);
const docsHref = '/docs';
---

<a href={docsHref} class="docs-link sl-flex" {...(Astro.url.pathname === '/docs' ? { 'aria-current': 'page' } : {})}>
  Documentation
</a>
{links.map(({ label, href, icon }) => (
  <a {href} rel="me" class="sl-flex">
    <span class="sr-only">{label}</span>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={ICONS[icon]} />
  </a>
))}

<style>
  @layer starlight.core {
    a {
      color: var(--sl-color-text-accent);
      padding: 0.5em;
      margin: -0.5em;
    }
    a:hover {
      color: var(--sl-color-white);
    }
    .docs-link {
      font-size: 0.875rem;
      font-weight: 500;
    }
  }
</style>
